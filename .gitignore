# makepkg の中間生成物 + 成果物
pkgs/*/src/
pkgs/*/pkg/
pkgs/*/*.pkg.tar.zst
pkgs/*/*.pkg.tar.zst.sig
pkgs/*/*.log
pkgs/*/*.tar.gz
pkgs/*/*.tar.xz
pkgs/*/*.7z.*
pkgs/*/*.whl
pkgs/*/*.zip
pkgs/*/*.deb
pkgs/*/*.sh
pkgs/*/*.desktop
pkgs/*/*.metainfo.xml
pkgs/*/*.png
pkgs/*/*.txt

# makepkg の source= ダウンロードキャッシュ (sha256 pin 済み、SRCDEST 未設定で
# pkgs/<name>/ 直下に落ちる。拡張子なし / git clone source は個別 pattern)
# (retired pkgs の entry は削除済み)

# python bytecode cache
__pycache__/
*.pyc

# 配信先 (build host で hosting する signed artifact、git には載せない)
repo/

# env-specific
.env
*.local
