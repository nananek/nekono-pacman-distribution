#!/usr/bin/env bash
# publish: push the signed repo/x86_64/ to the distribution host's WebDAV
# endpoint (dufs on :8080, see deploy/dist/). Uses the host rclone binary;
# docker is not required. Credentials come from env vars and are never
# committed. Independent of build-all; run it after a build.
#
# Required env (exported, or loaded from a local gitignored file on the build
# host: ~/.config/nekono-pacman/publish.env):
#   NEKONO_DAV_URL   e.g. http://nekono-dist0.<tailnet>.ts.net:8080  (dufs port)
#   NEKONO_DAV_USER  must match DUFS_USER in the dist host's .env
#   NEKONO_DAV_PASS  must match DUFS_PASS (plaintext) in the dist host's .env
#
# Loading the credentials here (instead of the agent sourcing them) keeps the
# values out of agent shell commands: `shell:*publish.env*` is policy-denied.
#
# Usage:
#   bin/publish [--json]
#     --json   print one JSON object on stdout (human/rclone log goes to
#              stderr). Consumed by nekono-pacman-agent; see bin/lib/json.sh.
#
# WHY TWO PASSES (important, do not "simplify" back to one sync):
#   dufs WebDAV cannot store a client-set mtime, so rclone treats ModTime as
#   unwritable and falls back to SIZE-ONLY change detection for `sync`. Package
#   files are immutable-by-filename (a given <name>-<ver> filename never changes
#   content), so size-only is safe for them and for deletions. But the repo db
#   metadata mutates IN PLACE every build: nekono.db{,.tar.gz}, nekono.files
#   {,.tar.gz}, and crucially their detached signatures — every *.sig is exactly
#   119 bytes, so a NEW signature over a NEW db has the SAME size as the old one
#   and `sync` SKIPS it. That silently leaves yesterday's nekono.db.sig over
#   today's nekono.db, and every client `pacman -Sy` fails SigLevel=Required db
#   verification (BAD signature). So:
#     pass 1: `sync`  -> uploads new packages, deletes retired ones (size-only OK)
#     pass 2: `copy --ignore-times` scoped to nekono.* -> force-refresh the db
#             metadata + sigs so the published sig always matches the published db
#   (Regression history: claude-code 2.1.201 publish, 2026-07-04.)
set -euo pipefail

JSON=false
case "${1:-}" in
    --json) JSON=true ;;
    "") ;;
    *)
        echo "usage: bin/publish [--json]" >&2
        exit 2
        ;;
esac

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO_DIR="$REPO_ROOT/repo/x86_64"

if $JSON; then
    # shellcheck source=lib/json.sh
    . "$REPO_ROOT/bin/lib/json.sh"
    exec 3>&1 1>&2
    j_pass="none"
    j_error=""
    j_log="$(mktemp -t nekono-publish-XXXXXX.log)"
    json_exit() {
        local rc=$? copied=0 deleted=0
        if [ -f "$j_log" ]; then
            copied="$(grep -c 'Copied (new)' "$j_log" 2>/dev/null || true)"
            deleted="$(grep -c 'Deleted' "$j_log" 2>/dev/null || true)"
            if [ "$rc" -ne 0 ] && [ -z "$j_error" ]; then
                j_error="$(grep -iE 'error|fatal' "$j_log" 2>/dev/null | tail -n 1 | cut -c1-200 || true)"
            fi
        fi
        printf '{"ok":%s,"pass":%s,"copied_new":%d,"deleted":%d,"error":%s,"rc":%d}\n' \
            "$(json_bool "$([ "$rc" -eq 0 ] && echo true)")" \
            "$(json_str "$j_pass")" \
            "${copied:-0}" \
            "${deleted:-0}" \
            "$(json_str "$j_error")" \
            "$rc" >&3
        rm -f "$j_log"
        return "$rc"
    }
    trap json_exit EXIT
fi

# Load credentials from the local, gitignored file when not already exported.
# Values are never echoed (the file path is the only thing printed on error).
_env="${HOME}/.config/nekono-pacman/publish.env"
if { [[ -z "${NEKONO_DAV_URL:-}" ]] || [[ -z "${NEKONO_DAV_USER:-}" ]] || [[ -z "${NEKONO_DAV_PASS:-}" ]]; } \
   && [[ -f "$_env" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$_env"
    set +a
fi

# Explicit checks (instead of `: ${VAR:?}`) so --json can report which variable
# is missing without ever printing its value.
for _v in NEKONO_DAV_URL NEKONO_DAV_USER NEKONO_DAV_PASS; do
    if [[ -z "${!_v:-}" ]]; then
        echo "[ERROR] $_v is not set (export it, or create $_env)" >&2
        j_error="${j_error:-$_v is not set}"
        exit 1
    fi
done

if [[ ! -f "$REPO_DIR/nekono.db.tar.gz" ]]; then
    echo "[ERROR] $REPO_DIR/nekono.db.tar.gz not found. Run bin/build-all first." >&2
    j_error="nekono.db.tar.gz not found (run bin/build-all first)"
    exit 1
fi

if ! command -v rclone >/dev/null; then
    echo "[ERROR] rclone not found. Install rclone on the build host." >&2
    j_error="rclone not found"
    exit 1
fi

# rclone stores WebDAV passwords obscured; obscure it with the host rclone.
echo "[*] Obscuring WebDAV password"
obsc="$(rclone obscure "$NEKONO_DAV_PASS")"

# Shared rclone invocation. The remote config is supplied through
# RCLONE_CONFIG_DIST_* env vars, so no rclone config file is written to disk.
rclone_run() {
    RCLONE_CONFIG_DIST_TYPE=webdav \
        RCLONE_CONFIG_DIST_URL="$NEKONO_DAV_URL" \
        RCLONE_CONFIG_DIST_VENDOR=other \
        RCLONE_CONFIG_DIST_USER="$NEKONO_DAV_USER" \
        RCLONE_CONFIG_DIST_PASS="$obsc" \
        rclone "$@"
}

# Run one rclone pass. In --json mode stdout+stderr are tee'd to a log so the
# summary can report how many files were copied/deleted, while the same log is
# still visible on stderr.
run_pass() {
    local pass="$1"
    shift
    j_pass="$pass"
    if $JSON; then
        rclone_run "$@" 2>&1 | tee -a "$j_log"
    else
        rclone_run "$@"
    fi
}

# Pass 1: bulk sync (uploads new packages, deletes retired ones). Size-only
# comparison is fine here because package filenames are immutable-by-version.
echo "[*] Publishing (pass 1/2: sync packages) $REPO_DIR -> $NEKONO_DAV_URL/x86_64"
run_pass "sync" sync --copy-links --checkers 4 --transfers 4 -v \
    "$REPO_DIR" dist:x86_64

# Pass 2: force-refresh the in-place-mutating db metadata + signatures. Without
# --ignore-times the same-size *.sig files are skipped and the published sig
# no longer matches the published db (see header). `copy` never deletes.
# This applies to BOTH the repo db (nekono.db*) and every detached package
# signature (*.sig, always 119 bytes) — a rebuilt package with the same
# filename keeps the same 119-byte size, so `sync` (size-only on WebDAV)
# would silently keep the stale signature and clients fail
# "signature is invalid" (regression: 14 stale *.sig on 2026-08-22).
echo "[*] Publishing (pass 2/2: force db metadata + sigs)"
run_pass "copy-db" copy --copy-links --ignore-times --include "nekono.*" --include "*.sig" -v \
    "$REPO_DIR" dist:x86_64

j_pass="done"
echo "[OK] publish complete"
