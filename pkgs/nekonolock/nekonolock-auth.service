[Unit]
Description=nekonolock authentication helper
Documentation=https://github.com/nananek/nekonolock
Requires=nekonolock-auth.socket

[Service]
Type=simple
ExecStart=/usr/bin/nekonolock-auth
Restart=on-failure
RestartSec=1s
UMask=0077

# systemd の sandbox / capability / namespace 制限は PAM の setuid 経路
# (unix_chkpwd / pam_faillock) と衝突するため入れない。CapabilityBoundingSet=
# は user manager で status=218/CAPABILITIES、RestrictAddressFamilies=AF_UNIX
# などは PAM 認証を失敗させることを実機で確認した。

# socket activation 専用。有効化するのは .socket だけで、.service は
# [Install] を持たない（systemd.socket の推奨構成）。
