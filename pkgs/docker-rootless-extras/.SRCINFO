pkgbase = docker-rootless-extras
	pkgdesc = Extras to run docker as non-root.
	pkgver = 29.8.0
	pkgrel = 1
	url = https://docs.docker.com/engine/security/rootless/
	install = docker-rootless-extras.install
	arch = any
	license = Apache-2.0
	provides = docker-rootless
	provides = docker-rootless-extras
	provides = docker-rootless-extras-bin
	conflicts = docker-rootless
	conflicts = docker-rootless-extras
	conflicts = docker-rootless-extras-bin
	source = dockerd-rootless-29.8.0.sh::https://raw.githubusercontent.com/moby/moby/docker-v29.8.0/contrib/dockerd-rootless.sh
	source = dockerd-rootless-setuptool-29.8.0.sh::https://raw.githubusercontent.com/moby/moby/docker-v29.8.0/contrib/dockerd-rootless-setuptool.sh
	source = docker.socket
	source = 99-docker-rootless.conf
	sha256sums = 200203633806081a401e60aefdf68a8fa73fc7dc80aa854c52a69d47710a3488
	sha256sums = 1c9f0dc93ebb3d75255254ec760d26a912affba7f329ab8abffe8e25eb0b3f94
