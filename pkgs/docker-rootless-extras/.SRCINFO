pkgname = docker-rootless-extras
	depends = bash
	depends = docker
	depends = rootlesskit
	depends = slirp4netns
	optdepends = fuse-overlayfs: overlayfs support
	optdepends = gvisor-tap-vsock: alternative network driver (used when slirp4netns is unavailable)
	optdepends = lxc: experimental lxc-user-nic network driver
	optdepends = passt: experimental pasta network / pesto port driver (IPv4 only)
