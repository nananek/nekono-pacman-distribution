# Based on the Arch Linux 'sane' package
#   by David Runge <dvzrv@archlinux.org> and Bert Peters <bertptrs@archlinux.org>

pkgname=sane-nekono
_pkgname=sane            # インストール先のファイル名/パスは公式と同一に保つ
pkgver=1.4.0
_nekonorel=nekono1
_srcdir="sane-backends-$pkgver-$_nekonorel"
pkgrel=1
pkgdesc="Scanner Access Now Easy (nekono fork: ScanSnap iX1400 hardware JPEG + fast polling)"
arch=(x86_64)
url="https://github.com/nananek/sane-backends"
license=(
  GPL-2.0-or-later
  LicenseRef-GPL-2.0-or-later-with-linking-exception
)
depends=(
  bash
  cairo
  glibc
  libgcc
  libpng
  libieee1284
  libstdc++
  net-snmp
  v4l-utils
)
makedepends=(
  autoconf-archive
  avahi
  curl
  glib2
  libgphoto2
  libjpeg-turbo
  libtiff
  libusb
  libxml2
  poppler-glib
  python
  systemd
  texlive-latexextra
)
optdepends=('sane-airscan: for scanners working in driverless mode')
provides=(sane=$pkgver libsane.so)
conflicts=(sane)
source=(
  "$_srcdir.tar.gz::https://github.com/nananek/sane-backends/archive/refs/tags/$pkgver-$_nekonorel.tar.gz"
  "$_pkgname-gcc16.patch::https://gitlab.com/sane-project/backends/-/commit/d04d17b456d9847021b6df6eb08a3419a75172cf.patch"
  66-${_pkgname}d.rules
  $_pkgname.sysusers
  ${_pkgname}d.service
  ${_pkgname}d.socket
)
