# Maintainer: Rafael Dominiquini <rafaeldominiquini at gmail dot com>
# Co-maintainer: edu4rdshl <edu4rdshl at protonmail dot com>
#
# nekono fork: AUR 版は `npm install` を main tarball (= 実体は
# npm-loader.js だけの薄いラッパー) にしか実行せず、build 時に npm の
# dependency resolver が `detect-libc` + 実 binary を積んだ
# optionalDependency `@github/copilot-linux-x64` (~170MB) を registry から
# 動的取得する (= CLAUDE.md の pip vendor 方針と同じ理由で [nekono] 不可)。
# 両 npm package を source[] に vendor + b2sum pin し、`npm install --offline`
# で完結させるよう package() を書き換えている。詳細は REVIEW.md 参照。

_npmmodule=@github/copilot
_platform=@github/copilot-linux-x64
_detectlibc_ver=2.1.2

pkgname=github-copilot-cli
_pkgexec=copilot

pkgver=1.0.81
pkgrel=1

pkgdesc="GitHub Copilot CLI brings the power of Copilot coding agent directly to your terminal."

url="https://github.com/github/copilot-cli"
_urlraw="https://raw.githubusercontent.com/github/copilot-cli/v${pkgver}"

arch=("x86_64")

license=("LicenseRef-GitHub-Copilot")

conflicts=("${pkgname%%-cli}" "${pkgname}-legacy")
depends=("glibc" "gcc-libs" "nodejs" "glib2" "libsecret")
replaces=("${pkgname%%-cli}")
makedepends=("npm" "jq")
provides=("${_pkgexec}")

options=(!strip emptydirs staticlibs zipman)

source=("https://registry.npmjs.org/${_npmmodule}/-/copilot-${pkgver}.tgz"
		"detect-libc-${_detectlibc_ver}.tgz::https://registry.npmjs.org/detect-libc/-/detect-libc-${_detectlibc_ver}.tgz"
		"copilot-linux-x64-${pkgver}.tgz::https://registry.npmjs.org/${_platform}/-/copilot-linux-x64-${pkgver}.tgz"
		"CHANGELOG-${pkgver}.md::${_urlraw}/changelog.md")
noextract=("copilot-${pkgver}.tgz"
           "detect-libc-${_detectlibc_ver}.tgz"
           "copilot-linux-x64-${pkgver}.tgz")

b2sums=('201e7d7fdac41f577c5fc48999e027699c848320db2134d527efa82f855198e216fa3c2cb120417764df7acfc9cc761020da862848c8e6d2e743e886f29d891a'
        'b036f6d45c8858d8d9b97f4788bb4fb02b2bbe8b7c09ea27b9b9d8241acdb4b3258c8401ac1a535c46e9f75a65f2bc962d53ac0b6230cea4df36578cf013b828'
        '2366adeeb28bccd5145f64a4ca6059aeee54bdba0f9c51ac605c9d519b96c8abf8b3f7c69c41f42e7e91356e4c12c4ed45f2894f3de68ae0fff9b718ec2d84b8'
        'afed114fefe3146fa877c8f056e1cd4685fa309478b5bf154736880f78ad4e268891a05a581c6a992c054dd9cd9a311a5b91d27ef10b7ffd975082c57bed5949')

# Document: https://wiki.archlinux.org/title/Node.js_package_guidelines
package() {
	msg2 "Install using npm (offline: main package + vendored deps together)"
	# Passing all three tarballs as explicit top-level install targets makes
	# npm hoist them as siblings under node_modules instead of trying to
	# resolve @github/copilot's optionalDependencies from the registry, so
	# --offline succeeds with only the vendored, sha-pinned source[] tarballs.
	npm install -s -g \
		--cache "${srcdir}/npm-cache" \
		--prefix "${pkgdir}/usr" \
		--offline \
		"${srcdir}/copilot-${pkgver}.tgz" \
		"${srcdir}/detect-libc-${_detectlibc_ver}.tgz" \
		"${srcdir}/copilot-linux-x64-${pkgver}.tgz"

	# The platform package also declares its own bin entry (raw native
	# executable exposed as `copilot-linux-x64`); we only want the `copilot`
	# wrapper (npm-loader.js) that AUR/upstream ship as the public command.
	rm -f "${pkgdir}/usr/bin/copilot-linux-x64"

	local _moddir="${pkgdir}/usr/lib/node_modules/${_npmmodule}"
	local _platdir="${pkgdir}/usr/lib/node_modules/${_platform}"

	# x86_64 only for now; adding aarch64 needs vendoring
	# @github/copilot-linux-arm64 (source[] + b2sums) as well.
	msg2 "Cleaning non-native prebuilds for x64"
	if [ -d "${_platdir}/prebuilds" ]; then
		find "${_platdir}/prebuilds" -mindepth 1 -maxdepth 1 -type d ! -name "linux-x64" -exec rm -rf {} +
	fi
	if [ -d "${_platdir}/mxc-bin" ]; then
		find "${_platdir}/mxc-bin" -mindepth 1 -maxdepth 1 -type d ! -name "x64" -exec rm -rf {} +
	fi
	if [ -d "${_platdir}/ripgrep/bin" ]; then
		find "${_platdir}/ripgrep/bin" -mindepth 1 -maxdepth 1 -type d ! -name "linux-x64" -exec rm -rf {} +
	fi
	if [ -d "${_platdir}/clipboard/node_modules/@teddyzhu" ]; then
		find "${_platdir}/clipboard/node_modules/@teddyzhu" -mindepth 1 -maxdepth 1 -type d ! -name "clipboard-linux-x64-gnu" -exec rm -rf {} +
	fi
	if [ -d "${_platdir}/foundry-local-sdk/node_modules/foundry-local-sdk/prebuilds" ]; then
		find "${_platdir}/foundry-local-sdk/node_modules/foundry-local-sdk/prebuilds" -mindepth 1 -maxdepth 1 -type d ! -name "linux-x64" -exec rm -rf {} +
	fi

	# pvrecorder only ships linux/x86_64; remove other OSes and non-native Linux archs
	if [ -d "${_platdir}/pvrecorder/node_modules/@picovoice/pvrecorder-node/lib" ]; then
		find "${_platdir}/pvrecorder/node_modules/@picovoice/pvrecorder-node/lib" -mindepth 1 -maxdepth 1 -type d ! -name 'linux' -exec rm -rf {} +
		find "${_platdir}/pvrecorder/node_modules/@picovoice/pvrecorder-node/lib/linux" -mindepth 1 -maxdepth 1 -type d ! -name 'x86_64' -exec rm -rf {} +
	fi

	msg2 "Fix ownership of ALL FILES"
	find "${pkgdir}/usr" -type d -exec chmod 755 {} +
	chown -R root:root "${pkgdir}"

	msg2 "Remove references to PKGDIR"
	find "${pkgdir}" -name package.json -print0 | xargs -r -0 sed -i '/_where/d'

	msg2 "Fixing 'package.json' (strip npm-injected _-prefixed fields, avoid srcdir leak)"
	local _modname
	for _modname in "${_npmmodule}" "${_platform}" detect-libc; do
		local tmppackage="$(mktemp)"
		local pkgjson="${pkgdir}/usr/lib/node_modules/${_modname}/package.json"
		jq '.|=with_entries(select(.key|test("_.+")|not))' "${pkgjson}" > "${tmppackage}"
		mv "${tmppackage}" "${pkgjson}"
		chmod 644 "${pkgjson}"
	done

	msg2 "More fixes for 'package.json'"
	find "${pkgdir}" -type f -name package.json | while read pkgjson; do
		local tmppackage="$(mktemp)"
		jq 'del(.man)' "${pkgjson}" > "${tmppackage}"
		mv "${tmppackage}" "${pkgjson}"
		chmod 644 "${pkgjson}"
	done

	msg2 "Generating autocompletions for Bash"
	"${pkgdir}/usr/bin/copilot" completion bash > copilot.bash
	install -Dm644 copilot.bash "${pkgdir}/usr/share/bash-completion/completions/copilot"

	msg2 "Generating autocompletions for Zsh"
	"${pkgdir}/usr/bin/copilot" completion zsh > _copilot
	install -Dm644 _copilot "${pkgdir}/usr/share/zsh/site-functions/_copilot"

	msg2 "Generating autocompletions for Fish"
	"${pkgdir}/usr/bin/copilot" completion fish > copilot.fish
	install -Dm644 copilot.fish "${pkgdir}/usr/share/fish/vendor_completions.d/copilot.fish"

	msg2 "Install README file"
	install -dm755 "${pkgdir}/usr/share/doc/${pkgname}/"
	ln -sf "/usr/lib/node_modules/${_npmmodule}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"

	msg2 "Install CHANGELOG file"
	install -Dm755 "${srcdir}/CHANGELOG-${pkgver}.md" "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"

	msg2 "Install LICENSE file"
	install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}/"
	ln -sf "/usr/lib/node_modules/${_npmmodule}/LICENSE.md" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
