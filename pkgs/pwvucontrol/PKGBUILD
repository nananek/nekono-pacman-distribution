# Contributor: Moabeat <moabeat@berlin.de>
# nekono-pacman-distribution の改変 (= AUR との diff):
#   - 無し (= 純 fork)。b2sums (BLAKE2) は暗号学的に強固なため
#     sha256sums への差し替えは不要 (pam_pkcs11 は md5 → sha256 だった文脈)。

pkgname=pwvucontrol
pkgver=0.5.3
pkgrel=2
pkgdesc="Pipewire volume control for GNOME"
url="https://github.com/saivert/pwvucontrol"
arch=(x86_64)
license=(GPL-3.0-only)

depends=(glib2 gtk4 libadwaita wireplumber)
makedepends=(rust clang meson blueprint-compiler)
checkdepends=(appstream-glib)

_commit=fd5c9d1e5458b625d45e4159634b5b072f66cde1
_srcdir="$pkgname-$_commit"
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit/$_srcdir.tar.gz")

b2sums=('a00b69ae226be9d4103ebf0de0a2566e3a47bb46b750b11d5a24057078be005876edc4095121393a5e4c4c6d47966a6c491803c4e08bf3d6b4c21314805d9492')

build() {
  arch-meson --reconfigure "$_srcdir" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"
}
